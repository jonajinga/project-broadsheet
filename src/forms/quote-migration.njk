---
title: Migration Quote
subtitle: Tell us what you're moving from. We'll send a flat-fee quote within two business days.
permalink: /forms/quote-migration/
---
<form class="form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ meta.web3formsKey }}">
  <input type="hidden" name="subject" value="New migration quote request">
  <input type="hidden" name="from_name" value="{{ meta.title }}">
  <input type="hidden" name="redirect" value="{{ meta.url }}/thank-you/">
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form__row">
    <label class="form__label form__label--required" for="name">Your name</label>
    <input class="form__input" id="name" name="name" type="text" required>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="email">Email</label>
    <input class="form__input" id="email" name="email" type="email" required>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="source_url">Current publication URL</label>
    <input class="form__input" id="source_url" name="source_url" type="url" placeholder="https://" required>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="platform">Current platform</label>
    <select class="form__select" id="platform" name="platform" required>
      <option value="">Pick one</option>
      <option>Ghost</option>
      <option>WordPress</option>
      <option>Substack</option>
      <option>Medium</option>
      <option>Squarespace</option>
      <option>Other / custom</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="article_count">Approximate article count</label>
    <input class="form__input" id="article_count" name="article_count" type="text" required placeholder="e.g. ~80">
  </div>
  <div class="form__row">
    <label class="form__label" for="images">Need images migrated too?</label>
    <select class="form__select" id="images" name="images">
      <option>Yes — rehost all images</option>
      <option>No — keep current URLs</option>
      <option>Not sure</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label" for="redirects">Need a redirect map?</label>
    <select class="form__select" id="redirects" name="redirects">
      <option>Yes — every old URL mapped to new</option>
      <option>No</option>
      <option>Not sure</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label" for="timeline">Timeline</label>
    <input class="form__input" id="timeline" name="timeline" type="text" placeholder="e.g. Within 30 days, or flexible">
  </div>
  <div class="form__row">
    <label class="form__label" for="notes">Notes</label>
    <textarea class="form__textarea" id="notes" name="notes" placeholder="Anything unusual about the source? Custom fields, paywalled content, multiple authors, etc."></textarea>
  </div>
  <div class="form__actions">
    <button class="btn btn--primary" type="submit">Request migration quote</button>
  </div>
</form>

{% include "partials/form-note.njk" %}

---
title: Hosting Inquiry
subtitle: Tell me about the publication you want hosted. I'll reply personally within one business day with next steps.
permalink: /forms/hosting-inquiry/
---
<form class="form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ meta.web3formsKey }}">
  <input type="hidden" name="subject" value="New hosting inquiry">
  <input type="hidden" name="from_name" value="{{ meta.title }}">
  <input type="hidden" name="redirect" value="{{ meta.url }}/thank-you/">
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form__row">
    <label class="form__label form__label--required" for="name">Your name</label>
    <input class="form__input" id="name" name="name" type="text" required>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="email">Email</label>
    <input class="form__input" id="email" name="email" type="email" required>
  </div>
  <div class="form__row">
    <label class="form__label" for="publication">Publication name or URL</label>
    <input class="form__input" id="publication" name="publication" type="text" placeholder="e.g. thefreethinkingtimes.com">
  </div>
  <div class="form__row">
    <label class="form__label" for="plan">Which tier interests you?</label>
    <select class="form__select" id="plan" name="plan">
      <option>Hosting Basic, $25/mo</option>
      <option>Hosting Plus, $39/mo</option>
      <option>Hosting Managed, $79/mo</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label" for="status">Is the site already built?</label>
    <select class="form__select" id="status" name="status">
      <option>Yes, it's on Project Broadsheet and needs a home</option>
      <option>Yes, but it's on another platform I'd like to move from</option>
      <option>No, I'd like to set it up first</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label" for="notes">Anything else I should know?</label>
    <textarea class="form__textarea" id="notes" name="notes"></textarea>
  </div>
  <div class="form__actions">
    <button class="btn btn--primary" type="submit">Send inquiry</button>
  </div>
</form>

{% include "partials/form-note.njk" %}

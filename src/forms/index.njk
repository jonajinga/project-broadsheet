---
title: Forms
eyebrow: Resources
subtitle: Every form on the site, in one place.
permalink: /forms/
---
<div class="grid grid-2" style="margin-block: var(--space-xl);">
  {% for f in forms %}
  <a class="card card--link" href="/forms/{{ f.slug }}/">
    <div class="card__eyebrow">Form</div>
    <h3 class="card__title">{{ f.name }}</h3>
    <p class="card__summary">{{ f.purpose }}</p>
  </a>
  {% endfor %}
</div>

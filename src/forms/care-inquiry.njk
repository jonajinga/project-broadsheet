---
title: Care Plan Inquiry
subtitle: Tell us about your publication. We'll recommend a plan and send pricing within one business day.
permalink: /forms/care-inquiry/
---
<form class="form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ meta.web3formsKey }}">
  <input type="hidden" name="subject" value="New care plan inquiry">
  <input type="hidden" name="from_name" value="{{ meta.title }}">
  <input type="hidden" name="redirect" value="{{ meta.url }}/thank-you/">
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

  <div class="form__row">
    <label class="form__label form__label--required" for="name">Your name</label>
    <input class="form__input" id="name" name="name" type="text" required>
  </div>
  <div class="form__row">
    <label class="form__label form__label--required" for="email">Email</label>
    <input class="form__input" id="email" name="email" type="email" required>
  </div>
  <div class="form__row">
    <label class="form__label" for="site_url">Publication URL</label>
    <input class="form__input" id="site_url" name="site_url" type="url" placeholder="https://">
  </div>
  <div class="form__row">
    <label class="form__label" for="plan">Interested in</label>
    <select class="form__select" id="plan" name="plan">
      <option>Care — $149/mo</option>
      <option>Care+ — $399/mo</option>
      <option>Editorial — $899/mo</option>
      <option>Not sure yet</option>
    </select>
  </div>
  <div class="form__row">
    <label class="form__label" for="volume">Expected article volume per month</label>
    <input class="form__input" id="volume" name="volume" type="text" placeholder="e.g. 4 articles, or unsure">
  </div>
  <div class="form__row">
    <label class="form__label" for="notes">Anything else we should know?</label>
    <textarea class="form__textarea" id="notes" name="notes"></textarea>
  </div>
  <div class="form__actions">
    <button class="btn btn--primary" type="submit">Send inquiry</button>
  </div>
</form>

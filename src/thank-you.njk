<section class="thank-you">
  <div class="container">
    <span class="eyebrow">Received</span>
    <h1 class="page-title">Thanks, we've got it.</h1>
    <p class="lead">Your message landed in our inbox. Here's what to expect.</p>
    <div class="thank-you__steps">
      <div class="thank-you__step">
        <div class="thank-you__step-num">1</div>
        <div>
          <div class="thank-you__step-title">Confirmation email</div>
          <p class="thank-you__step-body">You'll get a confirmation email within a few minutes at the address you provided. If it doesn't show up, check spam.</p>
        </div>
      </div>
      <div class="thank-you__step">
        <div class="thank-you__step-num">2</div>
        <div>
          <div class="thank-you__step-title">Reply within one business day</div>
          <p class="thank-you__step-body">We'll respond with next steps, a call confirmation, a quote, or a question to move things forward.</p>
        </div>
      </div>
      <div class="thank-you__step">
        <div class="thank-you__step-num">3</div>
        <div>
          <div class="thank-you__step-title">Keep exploring in the meantime</div>
          <p class="thank-you__step-body">Browse the <a href="/docs/">docs</a>, check out <a href="/showcase/">The Freethinking Times</a>, or <a href="/get-started/">try Project Broadsheet locally</a>. No account needed.</p>
        </div>
      </div>
    </div>
    <div style="margin-top: var(--space-xl);">
      <a class="btn btn--primary btn--lg" href="/">Back to home</a>
    </div>
  </div>
</section>

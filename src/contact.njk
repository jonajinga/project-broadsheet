---
layout: layouts/page.njk
title: Contact
eyebrow: Contact
subtitle: Questions, feedback, or just saying hi.
permalink: /contact/
---
<div class="contact-grid">
  <div>
    <h2 class="h3">General inquiries</h2>
    <p class="lead">Use the form below for anything that doesn't fit another page. For specific asks, jump to:</p>
    <ul style="list-style: disc; padding-left: 1.5rem; margin-block: var(--space-md);">
      <li><a href="/book-a-call/">Book a setup call</a> — for launch packages</li>
      <li><a href="/forms/quote-custom/">Request a custom quote</a> — for design or development</li>
      <li><a href="/forms/quote-migration/">Request a migration quote</a> — for moving an existing publication</li>
      <li><a href="/forms/bug-report/">Report a bug</a> — for anything wrong with Project Broadsheet itself</li>
      <li><a href="/forms/feature-request/">Request a feature</a> — for suggestions and ideas</li>
    </ul>

    <form class="form" action="https://api.web3forms.com/submit" method="POST" style="margin-top: var(--space-xl);">
      <input type="hidden" name="access_key" value="{{ meta.web3formsKey }}">
      <input type="hidden" name="subject" value="New contact message">
      <input type="hidden" name="from_name" value="{{ meta.title }}">
      <input type="hidden" name="redirect" value="{{ meta.url }}/thank-you/">
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

      <div class="form__row">
        <label class="form__label form__label--required" for="name">Your name</label>
        <input class="form__input" id="name" name="name" type="text" required>
      </div>
      <div class="form__row">
        <label class="form__label form__label--required" for="email">Email</label>
        <input class="form__input" id="email" name="email" type="email" required>
      </div>
      <div class="form__row">
        <label class="form__label" for="subject">Subject</label>
        <input class="form__input" id="subject" name="subject_custom" type="text" placeholder="What's this about?">
      </div>
      <div class="form__row">
        <label class="form__label form__label--required" for="message">Message</label>
        <textarea class="form__textarea" id="message" name="message" required></textarea>
      </div>
      <div class="form__actions">
        <button class="btn btn--primary" type="submit">Send message</button>
      </div>
    </form>
  </div>
  {% set sidebar = { title: "Fast answers", summary: "Check the docs before emailing — 90% of questions are already answered.", ctaUrl: "/docs/", ctaLabel: "Browse docs", list: ["Replies within 1 business day", "Bug reports use a separate form", "Launch inquiries go to Book a Call"] } %}
  {% include "partials/sidebar-cta.njk" %}
</div>

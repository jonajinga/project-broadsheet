---
layout: layouts/page.njk
title: Write to me
eyebrow: Contact
subtitle: Fill in the form and I'll get back to you, usually within a day.
permalink: /contact/
narrow: true
centered: true
---
<div class="lead" style="margin: 0 auto var(--space-xl); text-align: center;">
  Whatever you send goes straight to my inbox — no queue, no automation, no bot. Just me reading it.
</div>

<div class="stack-lg" style="max-width: 38rem; margin-inline: auto;">
  <form class="form" action="https://api.web3forms.com/submit" method="POST">
    <input type="hidden" name="access_key" value="{{ meta.web3formsKey }}">
    <input type="hidden" name="from_name" value="{{ meta.title }}">
    <input type="hidden" name="redirect" value="{{ meta.url }}/thank-you/">
    <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

    <div class="form__row">
      <label class="form__label form__label--required" for="name">Your name</label>
      <input class="form__input" id="name" name="name" type="text" required>
    </div>
    <div class="form__row">
      <label class="form__label form__label--required" for="email">Email</label>
      <input class="form__input" id="email" name="email" type="email" required>
    </div>
    <div class="form__row">
      <label class="form__label form__label--required" for="reason">What can I help you with?</label>
      <select class="form__select" id="reason" name="subject" required>
        <option value="" disabled selected>Select a reason</option>
        <option>General question</option>
        <option>Setup and launch help</option>
        <option>Content migration</option>
        <option>Managed hosting</option>
        <option>Training or consulting</option>
        <option>Custom development</option>
        <option>Bug report</option>
        <option>Feature request</option>
        <option>Docs feedback</option>
        <option>Something else</option>
      </select>
    </div>
    <div class="form__row">
      <label class="form__label form__label--required" for="message">Message</label>
      <textarea class="form__textarea" id="message" name="message" required></textarea>
    </div>
    <div class="form__actions">
      <button class="btn btn--primary" type="submit">Send message</button>
    </div>
  </form>

  {% include "partials/form-note.njk" %}
</div>

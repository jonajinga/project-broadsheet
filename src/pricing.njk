      <ul class="pricing-card__list">
        <li>Every feature included</li>
        <li>Every page of the docs</li>
        <li>Every example site as a reference</li>
        <li>Community help in GitHub Discussions</li>
      </ul>
      <a class="btn btn--primary btn--lg" href="/get-started/">How to get started</a>
    </div>
  </div>
</section>

<section class="pricing-section" id="my-time">
  <header class="pricing-section__header">

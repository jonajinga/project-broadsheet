---
layout: layouts/page.njk
title: What's changed
eyebrow: Changelog
subtitle: Every update to Project Broadsheet, with what's new, what's been fixed, and what's different.
permalink: /changelog/
---
{% for release in collections.releases %}
<article class="changelog-entry">
  <div class="changelog-entry__version">v{{ release.data.version }}</div>
  <div class="changelog-entry__date">{{ release.date | readableDate }}</div>
  <div class="changelog-entry__content">
    {{ release.content | safe }}
  </div>
</article>
{% endfor %}

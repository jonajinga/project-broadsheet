<header class="site-header" role="banner">
  <div class="container">
    <div class="site-header__inner">
      <a class="site-header__brand" href="/" aria-label="{{ meta.title }} home">
        <svg class="site-header__logo" viewBox="0 0 64 64" aria-hidden="true">
          <rect x="2" y="2" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
          <text x="32" y="38" fill="currentColor" font-family="'Playfair Display', Georgia, serif" font-weight="900" font-size="28" text-anchor="middle" letter-spacing="-0.5">PB</text>
          <line x1="10" y1="46" x2="54" y2="46" stroke="currentColor" stroke-width="1"/>
          <line x1="10" y1="50" x2="54" y2="50" stroke="currentColor" stroke-width="1"/>
          <line x1="10" y1="54" x2="44" y2="54" stroke="currentColor" stroke-width="1"/>
        </svg>
        <span>Project Broadsheet</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {% for item in nav.primary %}
          <li class="site-nav__item" data-id="{{ item.label | slugify }}" data-open="false">
            {% if item.children %}
              <a class="site-nav__link" href="{{ item.url }}"{% if page.url and (page.url == item.url or (item.url != '/' and page.url | string | slice(0, item.url | length) == item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>
              <button class="site-nav__chevron" type="button" aria-label="Toggle {{ item.label }} menu" onclick="toggleDropdown('{{ item.label | slugify }}', event)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="site-nav__dropdown" role="menu">
                {% for child in item.children %}
                <a class="site-nav__dropdown-item" href="{{ child.url }}" role="menuitem">
                  <div class="site-nav__dropdown-title">{{ child.label }}</div>
                  <div class="site-nav__dropdown-desc">{{ child.description }}</div>
                </a>
                {% endfor %}
              </div>
            {% else %}
              <a class="site-nav__link" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>
      <div class="site-header__actions">
        <button class="theme-toggle" type="button" aria-label="Toggle theme" onclick="toggleTheme()">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <a class="btn btn--primary btn--sm header-cta" href="{{ nav.cta.url }}">{{ nav.cta.label }}</a>
        <button class="hamburger" type="button" aria-label="Open menu" onclick="openMenu()">
          <svg class="hamburger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>

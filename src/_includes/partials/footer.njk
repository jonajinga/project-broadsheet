<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand-block">
        <a class="site-footer__brand" href="/">
          <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true">
            <rect x="2" y="2" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
            <text x="32" y="38" fill="currentColor" font-family="'Playfair Display', Georgia, serif" font-weight="900" font-size="28" text-anchor="middle" letter-spacing="-0.5">PB</text>
            <line x1="10" y1="46" x2="54" y2="46" stroke="currentColor" stroke-width="1"/>
            <line x1="10" y1="50" x2="54" y2="50" stroke="currentColor" stroke-width="1"/>
            <line x1="10" y1="54" x2="44" y2="54" stroke="currentColor" stroke-width="1"/>
          </svg>
          Project Broadsheet
        </a>
        <p class="site-footer__tagline">{{ meta.missionShort or meta.tagline }}</p>
        <div class="site-footer__badges">
          <span class="badge badge--mit">MIT</span>
        </div>
      </div>
      <div>
        <div class="site-footer__col-title">Product</div>
        <ul class="site-footer__list">
          <li><a href="/">Home</a></li>
          <li><a href="/features/">Features</a></li>
          <li><a href="/showcase/">Showcase</a></li>
          <li><a href="/get-started/">Get Started</a></li>
          <li><a href="/roadmap/">Roadmap</a></li>
          <li><a href="/changelog/">Changelog</a></li>
        </ul>
      </div>
      <div>
        <div class="site-footer__col-title">Compare</div>
        <ul class="site-footer__list">
          <li><a href="/compare/">All comparisons</a></li>
          <li><a href="/compare/ghost/">vs. Ghost</a></li>
          <li><a href="/compare/substack/">vs. Substack</a></li>
          <li><a href="/compare/wordpress/">vs. WordPress</a></li>
          <li><a href="/compare/superdesk/">vs. Superdesk</a></li>
        </ul>
      </div>
      <div>
        <div class="site-footer__col-title">Services</div>
        <ul class="site-footer__list">
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/book-a-call/">Book a Call</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <div class="site-footer__col-title">Docs</div>
        <ul class="site-footer__list">
          <li><a href="/docs/">All docs</a></li>
          <li><a href="/docs/getting-started/">Getting started</a></li>
          <li><a href="/docs/content/">Writing content</a></li>
          <li><a href="/docs/design/">Design</a></li>
          <li><a href="/docs/integrations/">Integrations</a></li>
          <li><a href="/docs/deployment/">Deployment</a></li>
          <li><a href="/docs/migration/">Migration</a></li>
        </ul>
      </div>
      <div>
        <div class="site-footer__col-title">Resources</div>
        <ul class="site-footer__list">
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/support/">Support</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/feed.xml">RSS feed</a></li>
        </ul>
      </div>
      <div>
        <div class="site-footer__col-title">Newsletter</div>
        {% if meta.buttondownUsername %}
        <p class="site-footer__newsletter">Release notes and occasional essays, written by me. No tracking, no sales pitches.</p>
        <form class="site-footer__newsletter-form" action="https://buttondown.email/api/emails/embed-subscribe/{{ meta.buttondownUsername }}" method="post" target="_blank">
          <label class="sr-only" for="footer-email">Email address</label>
          <input id="footer-email" type="email" name="email" placeholder="you@example.com" required>
          <button class="btn btn--primary btn--sm btn--block" type="submit">Subscribe</button>
        </form>
        {% else %}
        <p class="site-footer__newsletter site-footer__newsletter--soon">A newsletter is on the way. Check back soon, or follow along on <a href="{{ meta.github }}">GitHub</a>.</p>
        {% endif %}
        <p class="site-footer__newsletter" style="margin-top: var(--space-md);">
          GitHub: <a href="{{ meta.github }}">{{ meta.githubOwner }}/{{ meta.githubRepo }}</a>
        </p>
      </div>
    </div>
    <div class="site-footer__bottom">
      <div>© {{ '' | year }} {{ meta.title }}. {{ meta.license }} License. Website by <a href="https://www.pikespeakwebdesigns.com">Pikes Peak Web Designs</a>.</div>
      <div>
        <a href="/privacy/">Privacy</a> ·
        <a href="/terms/">Terms</a> ·
        <a href="/accessibility/">Accessibility</a> ·
        <a href="/license/">License</a> ·
        <a href="/style-guide/">Style Guide</a> ·
        <a href="/sitemap/">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<!doctype html>
<html lang="{{ meta.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {{ meta.shortTitle }}{% else %}{{ meta.title }}{% endif %}</title>
<meta name="description" content="{{ description or meta.description }}">
<meta name="theme-color" content="{{ meta.themeColor }}">
<link rel="canonical" href="{{ meta.url }}{{ page.url }}">
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:type" content="image/png">
<meta property="og:title" content="{% if title %}{{ title }} | {{ meta.shortTitle }}{% else %}{{ meta.title }}{% endif %}">
<meta property="og:description" content="{{ description or meta.description }}">
<meta property="og:url" content="{{ meta.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ meta.title }}">
<meta property="og:locale" content="{{ meta.locale }}">
<meta property="og:image" content="{{ meta.url }}{{ meta.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} | {{ meta.shortTitle }}{% else %}{{ meta.title }}{% endif %}">
<meta name="twitter:description" content="{{ description or meta.description }}">
<meta name="twitter:image" content="{{ meta.url }}{{ meta.ogImage }}">
<script>{% include "../partials/theme-init.inline.njk" %}</script>
<link rel="preconnect" href="https://fonts.bunny.net">
<link rel="stylesheet" href="https://fonts.bunny.net/css?family=playfair-display:700,900|lora:400,700|source-serif-4:400,600|dm-sans:400,500,600,700&display=swap">
<link rel="stylesheet" href="/assets/css/global.css?v={{ meta.version }}">
<link rel="alternate" type="application/rss+xml" title="{{ meta.title }} Blog" href="/feed.xml">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ meta.title }}",
  "url": "{{ meta.url }}",
  "logo": "{{ meta.url }}/assets/img/logo.svg",
  "email": "{{ meta.email }}",
  "sameAs": ["{{ meta.github }}"]
}
</script>
{% if meta.umamiWebsiteId and meta.umamiSrc %}
<script async defer src="{{ meta.umamiSrc }}" data-website-id="{{ meta.umamiWebsiteId }}"></script>
{% endif %}
{% if meta.gtranslate.enabled %}
<script>
  window.gtranslateSettings = {
    "default_language": "{{ meta.gtranslate.defaultLanguage }}",
    "languages": {{ meta.gtranslate.languages | dump | safe }},
    "wrapper_selector": ".gtranslate_wrapper",
    "flag_style": "3d",
    "flag_size": 20
  };
</script>
<script src="https://cdn.gtranslate.net/widgets/latest/float.js" defer></script>
{% endif %}
</head>
<body data-w3f-key="{{ meta.web3formsKey }}"{% if body_attrs %} {{ body_attrs | safe }}{% endif %}>
<a class="skip-link" href="#main">Skip to content</a>
{% include "../partials/header.njk" %}
{% include "../partials/menu-panel.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "../partials/footer-cta.njk" %}
{% include "../partials/footer.njk" %}
{% include "../partials/search-modal.njk" %}
<button class="back-to-top" id="back-to-top" type="button" aria-label="Back to top" onclick="scrollToTop()">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
</button>
{% if meta.gtranslate.enabled %}<div class="gtranslate_wrapper" aria-hidden="true"></div>{% endif %}
<script src="https://instant.page/5.2.0" type="module" defer integrity="sha384-jnZyxPjiipYXnSU0ygqeac2q7CVYMbh84q0uHVRRxEtvFPiQYbXWUorga2aqZJ0z"></script>
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
<script defer src="/assets/js/main.js"></script>
<script defer src="/assets/js/glossary.js"></script>
<script defer src="/assets/js/code-copy.js"></script>
<script defer src="/assets/js/search.js"></script>
</body>
</html>

---
layout: layouts/base.njk
---
{%- set containerClass = "container" -%}
{%- if narrow -%}{%- set containerClass = "container container-narrow" -%}{%- endif -%}
{%- if wide -%}{%- set containerClass = "container container-wide" -%}{%- endif -%}
{%- set headerAlign = "" -%}
{%- if centered -%}{%- set headerAlign = " page-header--center" -%}{%- endif -%}

{% if not hide_header %}
<section class="section-sm page-header{{ headerAlign }}">
  <div class="{{ containerClass }}">
    {% if breadcrumbs %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      {% for crumb in breadcrumbs %}
        {% if not loop.last %}
          <a href="{{ crumb.url }}">{{ crumb.label }}</a><span class="breadcrumbs__sep">/</span>
        {% else %}
          <span>{{ crumb.label }}</span>
        {% endif %}
      {% endfor %}
    </nav>
    {% endif %}
    {% if eyebrow %}<span class="eyebrow">{{ eyebrow }}</span>{% endif %}
    <h1 class="page-title">{{ title }}</h1>
    {% if subtitle %}<p class="page-subtitle">{{ subtitle }}</p>{% endif %}
  </div>
</section>
{% endif %}
<div class="{{ containerClass }} page-body">
  {{ content | safe }}
</div>

---
layout: layouts/page.njk
pagination:
  data: docCategories
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: /docs/{{ cat.slug }}/
eyebrow: Docs · Category
eleventyComputed:
  title: "{{ cat.name | safe }}"
  subtitle: "{{ cat.summary | safe }}"
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/">Home</a><span class="breadcrumbs__sep">/</span>
  <a href="/docs/">Docs</a><span class="breadcrumbs__sep">/</span>
  <span>{{ cat.name }}</span>
</nav>

{% set hasDocs = false %}
{% for d in collections.docs %}{% if d.data.category == cat.slug %}{% set hasDocs = true %}{% endif %}{% endfor %}

{% if hasDocs %}
<div class="grid grid-2 docs-category-articles">
{% for d in collections.docs %}{% if d.data.category == cat.slug %}
  <a class="card card--link" href="{{ d.url }}">
    <div class="card__eyebrow">Article</div>
    <h3 class="card__title">{{ d.data.title }}</h3>
    <p class="card__summary">{{ d.data.subtitle or d.data.description or "" }}</p>
  </a>
{% endif %}{% endfor %}
</div>
{% else %}
<div class="alert alert--info docs-category-empty">
  <strong>Coming soon.</strong>
  Articles for this category are being written. In the meantime, check the <a href="{{ meta.github }}">GitHub repo</a> or <a href="/book-a-call/">book a call</a>.
</div>
{% endif %}

<div class="callout docs-category-feedback">
  <div class="callout__title">Missing something?</div>
  <p>If this category should cover a topic that isn't here yet, <a href="/forms/docs-feedback/">send us feedback</a>.</p>
</div>

  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@sardine/eleventy-plugin-tinyhtml": "^0.2.0",
    "pagefind": "^1.1.0",
    "rimraf": "^6.0.1"
  }
